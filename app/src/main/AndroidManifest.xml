<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.aether.x">

    <!-- QUERY_ALL_PACKAGES: WAJIB agar GameProfileCatalog (lihat file itu)
         bisa mencocokkan SEMUA game di assets/gamelist.txt (500+ entri)
         terhadap aplikasi yang benar-benar terpasang di perangkat lewat
         PackageManager.getApplicationInfo(). Tanpa ini, Android 11+ (API 30)
         package visibility filtering membuat PackageManager gagal melihat
         hampir semua aplikasi lain kecuali yang didaftarkan eksplisit satu-
         satu di <queries> — tidak praktis untuk daftar 500+ game yang terus
         bertambah. Alternatif <queries> per-package SENGAJA tidak dipakai
         di sini (itulah sebabnya sebelumnya hanya Free Fire yang terdeteksi,
         game lain seperti Clash of Clans selalu gagal walau terpasang).
         CATATAN Play Store: penggunaan QUERY_ALL_PACKAGES wajib dijustifikasi
         saat submit ke Play Console (Policy > App content > Permissions
         declaration) — jelaskan bahwa AetherX perlu mendeteksi & menerapkan
         profil tweak untuk game yang terpasang dari katalog game yang
         didukung, bukan untuk tujuan lain. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <!-- Wajib agar Intent.ACTION_VIEW (buka tautan GitHub/Telegram di Tentang)
             bisa mendeteksi browser/aplikasi yang tersedia di perangkat. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Dipakai Firestore untuk mengambil ID pengguna global berurutan. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- FITUR BARU — Auto-Pairing ADB (lihat AdbAutoPairingDiscovery):
         ACCESS_WIFI_STATE wajib untuk NsdManager melakukan discovery mDNS
         yang stabil, dan CHANGE_WIFI_MULTICAST_STATE wajib untuk
         WifiManager.MulticastLock — tanpa lock ini banyak ROM (MIUI,
         ColorOS, dll) men-drop paket mDNS/Bonjour begitu layar idle,
         membuat "Searching for Pairing…" tidak pernah menemukan service
         walau Wireless debugging sudah aktif di perangkat yang sama. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".AetherXApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AetherX"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AetherX.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- REWORK TOTAL (lihat perintah rework — "hapus semua yang
             bersangkutan dengan shizuku"): provider rikka.shizuku.ShizukuProvider
             DIHAPUS. Privilese non-root sekarang ditangani sepenuhnya oleh
             AetherX sendiri lewat com.aether.x.core.adb (ADB tertanam,
             wireless pairing Android 11+), tidak butuh provider/manifest
             component tambahan apa pun — koneksi ADB murni socket TCP
             lokal ke adbd, tidak lewat ContentProvider/Binder cross-app. -->

        <!-- Overlay crosshair: foreground service, "specialUse" karena menampilkan
             elemen bantu di atas aplikasi lain (bukan media/lokasi/dll bawaan Android). -->
        <service
            android:name=".core.overlay.CrosshairOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="crosshair_overlay" />
        </service>

        <!-- Overlay Monitor FPS: sama seperti crosshair, foreground service
             "specialUse" untuk menampilkan panel statistik (FPS/CPU/GPU/suhu)
             di atas aplikasi lain. -->
        <service
            android:name=".core.overlay.FpsMonitorOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="fps_monitor_overlay" />
        </service>

        <!-- Pemantau Game Profile (khusus Root): TIDAK menggambar overlay,
             murni polling shell di background untuk menerapkan/mereset
             tweak root sesuai game yang sedang dimainkan pengguna. -->
        <service
            android:name=".core.monitor.GameProfileMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_profile_monitor" />
        </service>

        <!-- FITUR BARU: floating sidebar Game Booster — foreground service
             "specialUse" (sama pola dengan overlay lain di atas) yang
             menampilkan bubble/sidebar mengambang di atas game yang sedang
             dimainkan. -->
        <service
            android:name=".core.overlay.GameBoosterOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_booster_overlay" />
        </service>

        <!-- FITUR BARU: splash singkat Game Booster sebelum game dibuka —
             tema transparan (Theme.AetherX.Transparent) karena activity ini
             HANYA menampilkan animasi logo di atas latar tembus pandang,
             bukan layar penuh biasa. excludeFromRecents supaya tidak
             muncul sebagai entri terpisah di recent apps (splash ini hidup
             sangat singkat, menampilkannya di recents hanya membingungkan). -->
        <activity
            android:name=".ui.booster.GameBoosterSplashActivity"
            android:exported="false"
            android:theme="@style/Theme.AetherX.Transparent"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

    </application>
</manifest>
