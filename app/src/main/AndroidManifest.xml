<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.aether.x">

    <!-- QUERY_ALL_PACKAGES: WAJIB agar GameProfileCatalog (lihat file itu)
         bisa mencocokkan SEMUA game di assets/gamelist.txt (500+ entri)
         terhadap aplikasi yang benar-benar terpasang di perangkat lewat
         PackageManager.getApplicationInfo(). Tanpa ini, Android 11+ (API 30)
         package visibility filtering membuat PackageManager gagal melihat
         hampir semua aplikasi lain kecuali yang didaftarkan eksplisit satu-
         satu di <queries> — tidak praktis untuk daftar 500+ game yang terus
         bertambah. Alternatif <queries> per-package SENGAJA tidak dipakai
         di sini (itulah sebabnya sebelumnya hanya Free Fire yang terdeteksi,
         game lain seperti Clash of Clans selalu gagal walau terpasang).
         CATATAN Play Store: penggunaan QUERY_ALL_PACKAGES wajib dijustifikasi
         saat submit ke Play Console (Policy > App content > Permissions
         declaration) — jelaskan bahwa AetherX perlu mendeteksi & menerapkan
         profil tweak untuk game yang terpasang dari katalog game yang
         didukung, bukan untuk tujuan lain. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <!-- Wajib agar Intent.ACTION_VIEW (buka tautan GitHub/Telegram di Tentang)
             bisa mendeteksi browser/aplikasi yang tersedia di perangkat. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>

        <!-- ROLLBACK — WAJIB untuk Android 11+ (API 30) package visibility:
             tanpa deklarasi ini, PackageManager.getPackageInfo/
             getLaunchIntentForPackage untuk moe.shizuku.privileged.api
             (dipakai ShizukuManager.isShizukuInstalled/openShizukuManager)
             akan SELALU gagal seolah app-nya tidak terinstal, walau
             sebenarnya terpasang. Catatan: QUERY_ALL_PACKAGES di atas
             sebenarnya sudah cukup luas untuk ini juga, tapi entri eksplisit
             ini dipertahankan sebagai dokumentasi + jaring pengaman kalau
             suatu saat QUERY_ALL_PACKAGES dilepas (mis. demi kepatuhan Play
             Store yang lebih ketat). -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Dipakai Firestore untuk mengambil ID pengguna global berurutan. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ROLLBACK TOTAL (lihat perintah — "jadikan sistem adb kembali ke
         shizuku pure... hapus semua yang bersangkutan dengan adb
         tertanam"): permission khusus ADB tertanam (ACCESS_WIFI_STATE +
         CHANGE_WIFI_MULTICAST_STATE untuk mDNS discovery, WAKE_LOCK untuk
         menjaga proses pairing tetap hidup) SEMUA DIHAPUS — Shizuku murni
         tidak melakukan discovery jaringan atau pairing apa pun di sisi
         AetherX sama sekali, jadi permission ini tidak lagi dibutuhkan. -->

    <!-- Battery optimization TETAP dipertahankan: ROM agresif (MIUI dkk)
         bisa membunuh proses app Shizuku Manager di background walau
         service-nya sedang dipakai AetherX, memutus binder secara
         tiba-tiba. Dipakai HANYA untuk menampilkan dialog sistem resmi
         (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) — BUKAN dipaksakan
         otomatis. Lihat PrivilegeManager.requestIgnoreBatteryOptimizations. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".AetherXApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AetherX"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AetherX.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ROLLBACK TOTAL (lihat perintah — "jadikan sistem adb kembali
             ke shizuku pure"): TIDAK ada <provider> ShizukuProvider di
             sini — package ini adalah CLIENT Shizuku (`shizuku-api`), yang
             MENYEDIAKAN provider adalah app Shizuku Manager itu sendiri
             (moe.shizuku.privileged.api), bukan AetherX. AetherX hanya
             bind ke service yang sudah berjalan lewat Shizuku.pingBinder()
             / Shizuku.newProcess(), tidak butuh component manifest apa pun
             untuk itu. -->

        <!-- Overlay crosshair: foreground service, "specialUse" karena menampilkan
             elemen bantu di atas aplikasi lain (bukan media/lokasi/dll bawaan Android). -->
        <service
            android:name=".core.overlay.CrosshairOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="crosshair_overlay" />
        </service>

        <!-- Overlay Monitor FPS: sama seperti crosshair, foreground service
             "specialUse" untuk menampilkan panel statistik (FPS/CPU/GPU/suhu)
             di atas aplikasi lain. -->
        <service
            android:name=".core.overlay.FpsMonitorOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="fps_monitor_overlay" />
        </service>

        <!-- Pemantau Game Profile (khusus Root): TIDAK menggambar overlay,
             murni polling shell di background untuk menerapkan/mereset
             tweak root sesuai game yang sedang dimainkan pengguna. -->
        <service
            android:name=".core.monitor.GameProfileMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_profile_monitor" />
        </service>

        <!-- FITUR BARU: floating sidebar Game Booster — foreground service
             "specialUse" (sama pola dengan overlay lain di atas) yang
             menampilkan bubble/sidebar mengambang di atas game yang sedang
             dimainkan. -->
        <service
            android:name=".core.overlay.GameBoosterOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_booster_overlay" />
        </service>

        <!-- FITUR BARU: splash singkat Game Booster sebelum game dibuka —
             tema transparan (Theme.AetherX.Transparent) karena activity ini
             HANYA menampilkan animasi logo di atas latar tembus pandang,
             bukan layar penuh biasa. excludeFromRecents supaya tidak
             muncul sebagai entri terpisah di recent apps (splash ini hidup
             sangat singkat, menampilkannya di recents hanya membingungkan). -->
        <activity
            android:name=".ui.booster.GameBoosterSplashActivity"
            android:exported="false"
            android:theme="@style/Theme.AetherX.Transparent"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- FITUR BARU — Firebase Cloud Messaging: menerima push notifikasi
             maintenance/update/membership yang tetap sampai walau aplikasi
             sedang di-background ATAU sudah ditutup total (lihat KDoc
             AetherXFirebaseMessagingService). android:exported="false" wajib
             — service ini HANYA boleh dibangunkan oleh Google Play Services
             lewat intent internal sistem, bukan dari app lain mana pun. -->
        <service
            android:name=".core.messaging.AetherXFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification channel FCM untuk kasus TEPI (edge case)
             SDK menampilkan notifikasi bawaan sistem sebelum sempat
             memanggil AetherXFirebaseMessagingService.onMessageReceived
             (mis. notification message biasa yang tiba saat app killed di
             Android versi tertentu) — tanpa meta-data ini, Android 8+ (API
             26+) bisa menolak menampilkan pesan sama sekali karena channel
             belum terdaftar. Diarahkan ke channel GENERAL milik
             AetherXNotifier supaya tetap konsisten. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="aetherx_general_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/logo" />

    </application>
</manifest>
