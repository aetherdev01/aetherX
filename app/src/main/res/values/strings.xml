    <!-- Tweak khusus root -->
    <string name="tweak_section_root_cpu">CPU &amp; Performa (Root)</string>
    <string name="tweak_section_root_system">Memori &amp; Sistem (Root)</string>
    <string name="tweak_cpu_governor">Governor CPU</string>
    <string name="tweak_cpu_governor_desc">Pilih governor clock CPU: Performance untuk clock maksimum terus-menerus, Ondemand/Schedutil untuk seimbang, Battery untuk hemat daya, atau Universal untuk otomatis sesuai dukungan chipset (Snapdragon, MediaTek, Exynos). Butuh akses root.</string>
    <string name="tweak_cpu_governor_schedutil">Schedutil</string>
    <string name="tweak_cpu_governor_performance">Performance</string>
    <string name="tweak_cpu_governor_ondemand">Ondemand</string>
    <string name="tweak_cpu_governor_battery">Battery</string>
    <string name="tweak_cpu_governor_universal">Universal</string>
    <string name="tweak_cpu_performance">CPU Governor: Performance</string>
    <string name="tweak_cpu_performance_desc">Kunci clock CPU ke frekuensi maksimum selama bermain, mengurangi drop FPS akibat governor CPU turun-naik. Butuh akses root.</string>
    <string name="tweak_ram_priority">Swappiness Override</string>
    <string name="tweak_ram_priority_desc">Turunkan nilai swappiness kernel supaya sistem lebih jarang menukar data game ke swap/zram, menjaga game tetap di RAM. Butuh akses root.</string>
    <string name="tweak_thermal_throttle">Thermal Throttle Override</string>
    <string name="tweak_thermal_throttle_desc">Naikkan batas suhu trip point kernel sebelum sistem menurunkan clock CPU/GPU (throttling). Berguna untuk sesi main lama, tapi tingkatkan suhu perangkat pakai dengan hati-hati. Butuh akses root.</string>
    <string name="tweak_gpu_performance">GPU Governor: Performance</string>
    <string name="tweak_gpu_performance_desc">Kunci frekuensi GPU ke clock maksimum yang didukung selama bermain, mengurangi drop FPS akibat governor GPU turun-naik. Mendukung GPU Adreno (Snapdragon) maupun Mali/GED (MediaTek, Exynos). Butuh akses root.</string>
    <!-- FITUR BARU tweak ke-7 Game Profile: GPU Rendering Priority (SurfaceFlinger) -->
    <string name="tweak_gpu_rendering_priority">GPU Rendering Priority</string>
    <string name="tweak_gpu_rendering_priority_desc">Naikkan prioritas real-time SurfaceFlinger (compositor sistem) dan RenderThread game ke SCHED_FIFO, mengurangi jitter/frame drop akibat proses lain merebut jatah CPU tepat saat rendering perlu jalan. Butuh akses root.</string>
    <string name="tweak_io_scheduler_boost">I/O Scheduler: Latensi Rendah</string>
    <string name="tweak_io_scheduler_boost_desc">Ganti scheduler penyimpanan internal ke mode latensi rendah (kyber/bfq) supaya aset game lebih cepat dibaca dari storage. Butuh akses root.</string>

