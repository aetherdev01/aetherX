<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme. Compose draws its own Material3 theme on top of this;
         this XML theme mainly controls window chrome before Compose attaches
         (status bar, navigation bar, default background). AetherX default
         tampilan sekarang gelap ala tactical dashboard, bukan putih M3. -->
    <style name="Theme.AetherX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aetherx_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Cold-start splash screen, shown via androidx.core.splashscreen
         before MainActivity's setContent() is called.

         REWORK (lihat perintah rework — "splash screen sistem masih
         jelek"): windowSplashScreenAnimatedIcon SEKARANG memakai
         ic_aetherx_mark_splash (bukan ic_aetherx_mark langsung) — versi
         dengan inset/padding aman supaya logo tidak terlihat
         terpotong/gepeng akibat circular mask yang diterapkan Splash
         Screen API Android 12+. -->
    <style name="Theme.AetherX.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aetherx_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_aetherx_mark_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.AetherX</item>
    </style>

    <!-- FITUR BARU: dipakai GameBoosterSplashActivity — activity yang
         HANYA menampilkan animasi logo AetherX di atas latar tembus
         pandang sebelum sebuah game dibuka (lihat perintah rework: "saat
         buka gamenya ada animasi splash dari game boosternya"). -->
    <style name="Theme.AetherX.Transparent" parent="Theme.AetherX">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

</resources>
